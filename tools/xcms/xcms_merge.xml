<tool id="xcms_merge" name="xcms findChromPeaks Merger" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>Merge xcms findChromPeaks RData into a unique file to be used by group</description>

    <macros>
        <import>macros.xml</import>
        <import>macros_xcms.xml</import>
    </macros>

    <expand macro="requirements"/>
    <required_files>
        <include path="xcms_merge.r" />
        <include path="lib.r" />
    </required_files>
    <expand macro="stdio"/>

    <command><![CDATA[
        @COMMAND_RSCRIPT@xcms_merge.r

        images 'c("${"\",\"".join(map(str, $images))}")'

        #if str($sampleMetadata) != 'None':
            sampleMetadata '$sampleMetadata'
        #end if

        @COMMAND_FILE_LOAD@

    ]]></command>

    <inputs>
        <param name="images" type="data" format="rdata.xcms.findchrompeaks,rdata" label="@INPUT_IMAGE_LABEL@" help="It contains a xcms4::XcmsExperiment object from multiple findChromPeaks (*.raw.xset.RData)" multiple="true" />
        <param name="sampleMetadata" label="Sample metadata file " format="tabular" type="data" optional="true" help="must contain at least one column with the sample id and one column with the sample class"/>

        <expand macro="input_file_load"/>
    </inputs>

    <outputs>
        <data name="xsetRData" format="rdata.xcms.findchrompeaks" label="xset.merged.RData" from_work_dir="merged.RData" />
        <data name="sampleMetadataOutput" format="tabular" label="xset.merged.sampleMetadata.tsv" from_work_dir="sampleMetadata.tsv">
            <filter>not sampleMetadata</filter>
        </data>
    </outputs>

    <tests>
        <test expect_num_outputs="1">
            <param name="images" location="https://zenodo.org/records/22940496/files/ko15-xset.RData,https://zenodo.org/records/22940496/files/ko16-xset.RData,https://zenodo.org/records/22940496/files/wt15-xset.RData,https://zenodo.org/records/22940496/files/wt16-xset.RData" ftype="rdata"/>
            <expand macro="test_file_load_single"/>
            <param name="sampleMetadata" value="sampleMetadata.tsv" />
            <assert_stdout>
                <has_text text="wt16.CDF        wt16           WT      wt16.CDF" />
                <has_text text="wt15.CDF        wt15           WT      wt15.CDF" />
                <has_text text="ko16.CDF        ko16           KO      ko16.CDF" />
                <has_text text="ko15.CDF        ko15           KO      ko15.CDF" />
                <has_text text="Object of class XcmsExperiment" />
                <has_text text="Spectra: MS1 (5112)" />
                <has_text text="  - spectra: 4 sample(s) to 5112 element(s)" />
                <has_text text="  - chromatographic peaks: 3095 in MS level(s): 1" />
            </assert_stdout>
        </test>
    </tests>

    <help><![CDATA[

@HELP_AUTHORS@

==========================
xcms findChromPeaks Merger
==========================

-----------
Description
-----------

This tool allows you to run one xcms findChromPeaks process per sample in parallel and then to merge all RData images into one.
The result is then suitable for xcms groupChromPeaks.

You can provide a sampleMetadata table to attribute phenotypic values to your samples.


-----------------
Workflow position
-----------------

**Upstream tools**

========================= ===================== ==============================
Name                      Output file           Format
========================= ===================== ==============================
xcms.findChromPeaks       ``*``.xset.RData      rdata.xcms.findchrompeaks
------------------------- --------------------- ------------------------------
xcms.findChromPeaks       ``*``.xset.RData      rdata.xcms.findchrompeaks
------------------------- --------------------- ------------------------------
xcms.findChromPeaks       ``*``.xset.RData      rdata.xcms.findchrompeaks
------------------------- --------------------- ------------------------------
...                       ...                   ...
------------------------- --------------------- ------------------------------
Upload file [optional]    sampleMetadata        tabular
========================= ===================== ==============================

\

**Downstream tools**

=========================== ==================== ============================
Name                        Output file          Format
=========================== ==================== ============================
xcms.groupChromPeaks        merged.RData         rdata.xcms.findchrompeaks
=========================== ==================== ============================

---------------------------------------------------

**General schema of the metabolomic workflow**

.. image:: xcms_merge_workflow.png

---------------------------------------------------

-----------
Input files
-----------

=========================== ==================================
Parameter : num + label     Format
=========================== ==================================
1 : RData file              rdata.xcms.findchrompeaks
--------------------------- ----------------------------------
2 : RData file              rdata.xcms.findchrompeaks
--------------------------- ----------------------------------
N : RData file              rdata.xcms.findchrompeaks
--------------------------- ----------------------------------
Optional : sampleMetadata   tsv or csv
=========================== ==================================

\


Example of a sampleMetadata:

======================== ===============
sample_name              sample_group
======================== ===============
HU_neg_028               bio
------------------------ ---------------
HU_neg_034               bio
------------------------ ---------------
Blanc04                  blank
------------------------ ---------------
Blanc06                  blank
------------------------ ---------------
Blanc09                  blank
======================== ===============

\

------------
Output files
------------

merged.RData: rdata.xcms.findchrompeaks format

    | Rdata file that is necessary in the next step of the workflow "xcms.groupChromPeaks".

@HELP_XCMS_MANUAL@

---------------------------------------------------

Changelog/News
--------------

@HELP_XCMS_NEWVERSION_480@


    ]]></help>

    <expand macro="citation" />
</tool>
